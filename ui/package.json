{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "node --run test:tsc && node --run build:extension",
    "build:extension": "vite build --config vite.extension.ts",
    "ci:install": "echo ci:install",
    "ci:build": "pnpm run build && node --run ci:build:commit",
    "ci:build:commit": "git add ../style.css ../javascript/ && git commit ../style.css ../javascript/ -m \"build: update build\" & echo ci:build:commit",
    "lint": "eslint src --ext ts,tsx --fix --report-unused-disable-directives --max-warnings 0",
    "test:tsc": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "ag-grid-community": "^32.3.9",
    "notyf": "^3.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "<9 >=8.57.0",
    "eslint-plugin-deprecation": "^3.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "postcss": "^8.5.31",
    "sass": "^1.106.1",
    "tailwindcss": "^4.3.3",
    "typescript": "<7 >=6.0.3",
    "vite": "^8.3.5"
  }
}
