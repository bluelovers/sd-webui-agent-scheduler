{
  "name": "ui",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://github.com/bluelovers/sd-webui-agent-scheduler#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/sd-webui-agent-scheduler/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/sd-webui-agent-scheduler.git"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint src --ext ts,tsx --fix --report-unused-disable-directives --max-warnings 0",
    "test:tsc": "tsc --noEmit & echo TypeScript check completed (main)",
    "build": "node --run test:tsc && node --run build:extension",
    "build:extension": "vite build --config vite.extension.ts",
    "ci:install": "pnpm install --frozen-lockfile && pnpm add -w typescript tsx ynpx @yarn-tool/changelog",
    "ci:build": "pnpm run build && node --run ci:build:commit && pnpm run postpublish:changelog && pnpm run postpublish",
    "ci:build:commit": "git add ../style.css ../javascript/ && git commit ../style.css ../javascript/ -m \"build: update build\" & echo ci:build:commit",
    "postpublish": "pnpm run postpublish:git:commit && pnpm run postpublish:git:tag && pnpm run postpublish:git:push",
    "postpublish:changelog": "ynpx --quiet @yarn-tool/changelog && git add ./CHANGELOG.md && node --run postpublish:changelog:copy & echo postpublish:changelog",
    "postpublish:changelog:copy": "git add ./CHANGELOG.md & copy /y .\\CHANGELOG.md ..\\CHANGELOG.md & echo postpublish:changelog:copy",
    "postpublish:git:commit": "git commit -m \"chore(release): publish\" & echo postpublish:git:commit",
    "postpublish:git:push": "git push --follow-tags",
    "postpublish:git:tag": "ynpx --quiet @yarn-tool/tag -- -f",
    "preview": "vite preview"
  },
  "dependencies": {
    "ag-grid-community": "^32.3.9",
    "notyf": "^3.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "<9 >=8.57.0",
    "eslint-plugin-deprecation": "^3.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "postcss": "^8.5.31",
    "sass": "^1.106.1",
    "tailwindcss": "^4.3.3",
    "typescript": "<7 >=6.0.3",
    "vite": "^8.3.5"
  }
}
